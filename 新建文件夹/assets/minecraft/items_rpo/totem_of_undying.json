{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui"],
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/totem_of_undying${guiType}${guiSuffix}"
        }
      },
      {
        "when": ["ground"],
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/totem_of_undying${groundType}${groundSuffix}"
        }
      },
      {
        "when": ["fixed"],
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/totem_of_undying${fixedType}${fixedSuffix}"
        }
      },
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/totem_of_undying${fpType}${fpSuffix}"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/totem_of_undying${tpType}${tpSuffix}"
    }
  }
}
