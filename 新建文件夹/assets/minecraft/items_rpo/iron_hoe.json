{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${guiPrefix}iron_hoe${guiSuffix}"
          }
        },
        {
          "when": ["ground"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${groundPrefix}iron_hoe${groundSuffix}"
          }
        },
        {
          "when": ["fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${fixedPrefix}iron_hoe${fixedSuffix}"
          }
        },
        {
          "when": ["firstperson_lefthand", "firstperson_righthand"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/enchanted_iron_hoe${fpOutlineType}"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/enchanted_iron_hoe${outlineType}"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["fixed", "ground", "gui"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/iron_hoe"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/iron_hoe"
      }
    }
  }
}