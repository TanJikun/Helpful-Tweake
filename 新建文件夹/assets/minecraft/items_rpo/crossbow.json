{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${guiPrefix}crossbow_arrow${guiSuffix}"
                },
                "when": "arrow"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${guiPrefix}crossbow_firework${guiSuffix}"
                },
                "when": "rocket"
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/${guiPrefix}crossbow${guiSuffix}"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "entries": [
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/${guiPrefix}crossbow_pulling_1${guiSuffix}"
                    },
                    "threshold": 0.58
                  },
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/${guiPrefix}crossbow_pulling_2${guiSuffix}"
                    },
                    "threshold": 1.0
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${guiPrefix}crossbow_pulling_0${guiSuffix}"
                },
                "property": "minecraft:crossbow/pull"
              },
              "property": "minecraft:using_item"
            },
            "property": "minecraft:charge_type"
          }
        },
        {
          "when": ["ground"],
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${groundPrefix}crossbow_arrow${groundSuffix}"
                },
                "when": "arrow"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${groundPrefix}crossbow_firework${groundSuffix}"
                },
                "when": "rocket"
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "on_false": {
                "type": "minecraft:model",
                "model": "item/${groundPrefix}crossbow${groundSuffix}"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "entries": [
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/${groundPrefix}crossbow_pulling_1${groundSuffix}"
                    },
                    "threshold": 0.58
                  },
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/${groundPrefix}crossbow_pulling_2${groundSuffix}"
                    },
                    "threshold": 1.0
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "item/${groundPrefix}crossbow_pulling_0${groundSuffix}"
                },
                "property": "minecraft:crossbow/pull"
              },
              "property": "minecraft:using_item"
            },
            "property": "minecraft:charge_type"
          }
        },
        {
          "when": ["fixed"],
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${fixedPrefix}crossbow_arrow${fixedSuffix}"
                },
                "when": "arrow"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/${fixedPrefix}crossbow_firework${fixedSuffix}"
                },
                "when": "rocket"
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "on_false": {
                "type": "minecraft:model",
                "model": "item/${fixedPrefix}crossbow${fixedSuffix}"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "entries": [
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/${fixedPrefix}crossbow_pulling_1${fixedSuffix}"
                    },
                    "threshold": 0.58
                  },
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/${fixedPrefix}crossbow_pulling_2${fixedSuffix}"
                    },
                    "threshold": 1.0
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "item/${fixedPrefix}crossbow_pulling_0${fixedSuffix}"
                },
                "property": "minecraft:crossbow/pull"
              },
              "property": "minecraft:using_item"
            },
            "property": "minecraft:charge_type"
          }
        },
        {
          "when": ["firstperson_lefthand", "firstperson_righthand"],
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_arrow${fpOutlineType}"
                },
                "when": "arrow"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_firework${fpOutlineType}"
                },
                "when": "rocket"
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "on_false": {
                "type": "minecraft:model",
                "model": "item/enchanted_crossbow${fpOutlineType}"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "entries": [
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/enchanted_crossbow_pulling_1${fpOutlineType}"
                    },
                    "threshold": 0.58
                  },
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "item/enchanted_crossbow_pulling_2${fpOutlineType}"
                    },
                    "threshold": 1.0
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_pulling_0${fpOutlineType}"
                },
                "property": "minecraft:crossbow/pull"
              },
              "property": "minecraft:using_item"
            },
            "property": "minecraft:charge_type"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "cases": [
          {
            "model": {
              "type": "minecraft:model",
              "model": "item/enchanted_crossbow_arrow${outlineType}"
            },
            "when": "arrow"
          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "item/enchanted_crossbow_firework${outlineType}"
            },
            "when": "rocket"
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "on_false": {
            "type": "minecraft:model",
            "model": "item/enchanted_crossbow${outlineType}"
          },
          "on_true": {
            "type": "minecraft:range_dispatch",
            "entries": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_pulling_1${outlineType}"
                },
                "threshold": 0.58
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "item/enchanted_crossbow_pulling_2${outlineType}"
                },
                "threshold": 1.0
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "item/enchanted_crossbow_pulling_0${outlineType}"
            },
            "property": "minecraft:crossbow/pull"
          },
          "property": "minecraft:using_item"
        },
        "property": "minecraft:charge_type"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "ground", "fixed"],
          "model": {
            "type": "minecraft:select",
            "cases": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_arrow"
                },
                "when": "arrow"
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework"
                },
                "when": "rocket"
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "entries": [
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_1"
                    },
                    "threshold": 0.58
                  },
                  {
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_2"
                    },
                    "threshold": 1.0
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_0"
                },
                "property": "minecraft:crossbow/pull"
              },
              "property": "minecraft:using_item"
            },
            "property": "minecraft:charge_type"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "cases": [
          {
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_arrow"
            },
            "when": "arrow"
          },
          {
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_firework"
            },
            "when": "rocket"
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow"
          },
          "on_true": {
            "type": "minecraft:range_dispatch",
            "entries": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_1"
                },
                "threshold": 0.58
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_2"
                },
                "threshold": 1.0
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_pulling_0"
            },
            "property": "minecraft:crossbow/pull"
          },
          "property": "minecraft:using_item"
        },
        "property": "minecraft:charge_type"
      }
    }
  }
}
