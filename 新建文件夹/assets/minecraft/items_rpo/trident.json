{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${guiPrefix}trident_sprite${guiSuffix}"
          }
        },
        {
          "when": ["ground"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${groundPrefix}trident_sprite${groundSuffix}"
          }
        },
        {
          "when": ["fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${fixedPrefix}trident_sprite${fixedSuffix}"
          }
        },
        {
          "when": ["firstperson_lefthand", "firstperson_righthand"],
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:special",
                  "model": { "type": "minecraft:trident" },
                  "base": "minecraft:item/trident_throwing"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/enchanted_trident_throwing${fpOutlineType}"
                }
              ]
            },
            "on_false": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:special",
                  "model": { "type": "minecraft:trident" },
                  "base": "minecraft:item/trident_in_hand"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/enchanted_trident_in_hand${fpOutlineType}"
                }
              ]
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:special",
              "model": { "type": "minecraft:trident" },
              "base": "minecraft:item/trident_throwing"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_trident_throwing${outlineType}"
            }
          ]
        },
        "on_false": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:special",
              "model": { "type": "minecraft:trident" },
              "base": "minecraft:item/trident_in_hand"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_trident_in_hand${outlineType}"
            }
          ]
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["fixed", "ground", "gui"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident_sprite"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:special",
          "model": { "type": "minecraft:trident" },
          "base": "minecraft:item/trident_throwing"
        },
        "on_false": {
          "type": "minecraft:special",
          "model": { "type": "minecraft:trident" },
          "base": "minecraft:item/trident_in_hand"
        }
      }
    }
  }
}
