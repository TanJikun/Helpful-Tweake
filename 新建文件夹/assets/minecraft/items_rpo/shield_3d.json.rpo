        fpOutlineType: "enchantmentGlows.outlines.firstPerson.thin ? '_thin' : (enchantmentGlows.outlines.firstPerson.extraThin ? '_thin_extra' : (enchantmentGlows.outlines.firstPerson.medium ? '_medium' : (enchantmentGlows.outlines.firstPerson.thick ? '_thick' : '_thick_extra')))",
        groundShieldModel: "enchantmentGlows.outlines.ground.off ? 'empty' : (enchantmentGlows.outlines.ground.thin ? 'enchanted_shield_thin' : (enchantmentGlows.outlines.ground.extraThin ? 'enchanted_shield_thin_extra' : 'enchanted_shield'))",
        fixedShieldModel: "enchantmentGlows.outlines.fixed.off ? 'empty' : (enchantmentGlows.outlines.fixed.thin ? 'enchanted_shield_thin' : (enchantmentGlows.outlines.fixed.extraThin ? 'enchanted_shield_thin_extra' : 'enchanted_shield'))",
