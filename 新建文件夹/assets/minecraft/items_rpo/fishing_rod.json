{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:condition",
      "property": "minecraft:fishing_rod/cast",
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": ["gui"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${guiPrefix}fishing_rod${guiSuffix}"
            }
          },
          {
            "when": ["ground"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${groundPrefix}fishing_rod${groundSuffix}"
            }
          },
          {
            "when": ["fixed"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${fixedPrefix}fishing_rod${fixedSuffix}"
            }
          },
          {
            "when": ["firstperson_lefthand", "firstperson_righthand"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_fishing_rod${fpOutlineType}"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/enchanted_fishing_rod${outlineType}"
        }
      },
      "on_true": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": ["gui"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${guiPrefix}fishing_rod_cast${guiSuffix}"
            }
          },
          {
            "when": ["ground"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${groundPrefix}fishing_rod_cast${groundSuffix}"
            }
          },
          {
            "when": ["fixed"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/${fixedPrefix}fishing_rod_cast${fixedSuffix}"
            }
          },
          {
            "when": ["firstperson_lefthand", "firstperson_righthand"],
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_fishing_rod_cast${fpOutlineType}"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/enchanted_fishing_rod_cast${outlineType}"
        }
      }
    },
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:fishing_rod/cast",
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod_cast"
      }
    }
  }
}
