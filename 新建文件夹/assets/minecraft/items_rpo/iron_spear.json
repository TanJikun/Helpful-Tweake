{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "on_shelf"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${guiPrefix}iron_spear${guiSuffix}"
          }
        },
        {
          "when": ["ground"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${groundPrefix}iron_spear${groundSuffix}"
          }
        },
        {
          "when": ["fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/${fixedPrefix}iron_spear${fixedSuffix}"
          }
        },
        {
          "when": ["firstperson_lefthand", "firstperson_righthand"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/enchanted_iron_spear_in_hand${fpOutlineType}"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/enchanted_iron_spear_in_hand${outlineType}"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["fixed", "ground", "gui", "on_shelf"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/iron_spear"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/iron_spear_in_hand"
      }
    }
  }
}

