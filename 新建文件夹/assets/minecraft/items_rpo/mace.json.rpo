{
    expansions: {
        outlineType: "enchantmentGlows.outlines.thirdPerson.thin ? '_thin' : (enchantmentGlows.outlines.thirdPerson.extraThin ? '_thin_extra' : (enchantmentGlows.outlines.thirdPerson.medium ? '_medium' : (enchantmentGlows.outlines.thirdPerson.thick ? '_thick' : '_thick_extra')))",
