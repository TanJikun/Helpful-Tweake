        guiPrefix: "enchantmentGlows.outlines.gui.off ? '' : 'enchanted_'",
        guiSuffix: "enchantmentGlows.outlines.gui.thin ? '_thin' : (enchantmentGlows.outlines.gui.extraThin ? '_thin_extra' : (enchantmentGlows.outlines.gui.medium ? '_medium' : (enchantmentGlows.outlines.gui.thick ? '_thick' : (enchantmentGlows.outlines.gui.thickExtra ? '_thick_extra' : ''))))",
        enchantedHandModel: "enchantmentGlows.appearance.maceStyle.sprite ? 'enchanted_mace_sprite' : 'enchanted_mace'",
