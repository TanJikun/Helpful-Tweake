        groundPrefix: "enchantmentGlows.outlines.ground.off ? '' : 'enchanted_'",
        groundSuffix: "enchantmentGlows.outlines.ground.thin ? '_thin' : (enchantmentGlows.outlines.ground.extraThin ? '_thin_extra' : (enchantmentGlows.outlines.ground.medium ? '_medium' : (enchantmentGlows.outlines.ground.thick ? '_thick' : (enchantmentGlows.outlines.ground.thickExtra ? '_thick_extra' : ''))))",
