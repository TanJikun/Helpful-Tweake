{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui"],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/${guiShieldModel}"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/shield_sprite"
          }
        }
      },
      {
        "when": ["ground"],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/${groundShieldModel}"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/shield_sprite"
          }
        }
      },
      {
        "when": ["fixed"],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/${fixedShieldModel}"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/shield_sprite"
          }
        }
      },
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand"
        ],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "property": "minecraft:using_item",
            "type": "minecraft:condition",
            "on_false": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/enchanted_shield${fpOutlineType}"
                },
                {
                  "type": "minecraft:special",
                  "model": {
                    "type": "minecraft:shield"
                  },
                  "base": "minecraft:item/shield",
                  "transformation": {
                    "left_rotation": [0.0, 0.0, 0.0, 1.0],
                    "right_rotation": [0.0, 0.0, 0.0, 1.0],
                    "scale": [1.0, -1.0, -1.0],
                    "translation": [0.0, 0.0, 0.0]
                  }
                }
              ]
            },
            "on_true": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/enchanted_shield_blocking${fpOutlineType}"
                },
                {
                  "type": "minecraft:special",
                  "model": {
                    "type": "minecraft:shield"
                  },
                  "base": "minecraft:item/shield_blocking",
                  "transformation": {
                    "left_rotation": [0.0, 0.0, 0.0, 1.0],
                    "right_rotation": [0.0, 0.0, 0.0, 1.0],
                    "scale": [1.0, -1.0, -1.0],
                    "translation": [0.0, 0.0, 0.0]
                  }
                }
              ]
            }
          },
          "on_false": {
            "type": "minecraft:condition",
            "on_false": {
              "type": "minecraft:special",
              "base": "minecraft:item/shield",
              "model": {
                "type": "minecraft:shield"
              }
            },
            "on_true": {
              "type": "minecraft:special",
              "base": "minecraft:item/shield_blocking",
              "model": {
                "type": "minecraft:shield"
              }
            },
            "property": "minecraft:using_item",
            "transformation": {
              "left_rotation": [0.0, 0.0, 0.0, 1.0],
              "right_rotation": [0.0, 0.0, 0.0, 1.0],
              "scale": [1.0, -1.0, -1.0],
              "translation": [0.0, 0.0, 0.0]
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "minecraft:enchantments",
      "ignore_default": true,
      "on_true": {
        "property": "minecraft:using_item",
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_shield${outlineType}"
            },
            {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "minecraft:item/shield",
              "transformation": {
                "left_rotation": [0.0, 0.0, 0.0, 1.0],
                "right_rotation": [0.0, 0.0, 0.0, 1.0],
                "scale": [1.0, -1.0, -1.0],
                "translation": [0.0, 0.0, 0.0]
              }
            }
          ]
        },
        "on_true": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/enchanted_shield_blocking${outlineType}"
            },
            {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "minecraft:item/shield_blocking",
              "transformation": {
                "left_rotation": [0.0, 0.0, 0.0, 1.0],
                "right_rotation": [0.0, 0.0, 0.0, 1.0],
                "scale": [1.0, -1.0, -1.0],
                "translation": [0.0, 0.0, 0.0]
              }
            }
          ]
        }
      },
      "on_false": {
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield_blocking",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "property": "minecraft:using_item",
        "transformation": {
          "left_rotation": [0.0, 0.0, 0.0, 1.0],
          "right_rotation": [0.0, 0.0, 0.0, 1.0],
          "scale": [1.0, -1.0, -1.0],
          "translation": [0.0, 0.0, 0.0]
        }
      }
    }
  }
}
